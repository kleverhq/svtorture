    {
      "id": "SV-2023-K-VPI-HEADER-TIME-DELAY-TYPES",
      "revisions": {
        "1800-2012": {
          "evidence": {
            "located_clause": "K.2",
            "printed_pages": [
              "1238",
              "1239"
            ]
          },
          "revision_rule": {
            "clause": "K.2",
            "note": "The 2012 header defines the same time and delay structures and time constants, but s_vpi_time/p_vpi_time are unguarded; the VPI_TIME conditional guard was added in 2023.",
            "status": "changed-expectation"
          }
        },
        "1800-2017": {
          "evidence": {
            "located_clause": "K.2",
            "printed_pages": [
              "1277"
            ]
          },
          "revision_rule": {
            "clause": "K.2",
            "note": "The 2017 header defines s_vpi_time/p_vpi_time unconditionally; the VPI_TIME guard around that type and its time constants was added in 2023. The delay structure itself has the same members and types.",
            "status": "changed-expectation"
          }
        }
