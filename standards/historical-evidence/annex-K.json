      "revisions": {
        "1800-2012": {
          "evidence": {
            "located_clause": "K.2",
            "printed_pages": [
              "1234"
            ]
          },
          "revision_rule": {
            "clause": "K.2",
            "note": "The 2012 mapping ends with vpiUwire as 13; it does not define the 2023 user-defined nettype values vpiNettypeNet/vpiNettypeNetSelect or vpiInterconnect.",
            "status": "changed-expectation"
          }
        },
        "1800-2017": {
          "evidence": {
            "located_clause": "K.2",
            "printed_pages": [
              "1273"
            ]
          },
          "revision_rule": {
            "clause": "K.2",
            "note": "The 2017 header defines net subtypes only through vpiUwire (13); the vpiNettypeNet, vpiNettypeNetSelect, and vpiInterconnect mappings required in 2023 are absent.",
            "status": "changed-expectation"
          }
        }
      }
