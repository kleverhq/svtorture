    {
      "id": "SV-2023-24-PROGRAM-DECLARATION-GRAMMAR",
      "revisions": {
        "1800-2012": {
          "evidence": {
            "located_clause": "24.3",
            "printed_pages": [
              "705",
              "706"
            ]
          },
          "revision_rule": {
            "clause": "24.3",
            "note": "The 2012 named-program grammar has the same declaration alternatives, but its program_generate_item production does not include an elaboration severity system task.",
            "status": "changed-expectation"
          }
        },
        "1800-2017": {
          "evidence": {
            "located_clause": "24.3",
            "printed_pages": [
              "742",
              "743"
            ]
          },
          "revision_rule": {
            "clause": "24.3",
            "note": "The 2017 program-item grammar lacks the 2023 elaboration-severity system-task generate item, and its anonymous-program item grammar lacks interface-class declarations.",
            "status": "changed-expectation"
          }
        }
      }
