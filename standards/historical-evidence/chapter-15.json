    {
      "id": "SV-2023-15-EVENT-TRIGGER-SYNTAX",
      "revisions": {
        "1800-2012": {
          "evidence": {
            "located_clause": "15.5.1",
            "printed_pages": [
              "326"
            ]
          },
          "revision_rule": {
            "clause": "15.5.1",
            "note": "The 2012 grammar permits only a hierarchical event identifier; the later optional nonrange selects are absent.",
            "status": "changed-expectation"
          }
        },
        "1800-2017": {
          "evidence": {
            "located_clause": "15.5.1",
            "printed_pages": [
              "360"
            ]
          },
          "revision_rule": {
            "clause": "15.5.1",
            "note": "The 2017 event-trigger grammar ends each form at hierarchical_event_identifier and does not include the 2023 nonrange_select suffix.",
            "status": "changed-expectation"
          }
        }
      }
    },
