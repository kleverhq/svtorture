    {
      "id": "SV-2023-35-DPI-IMPORT-EXPORT-GRAMMAR",
      "revisions": {
        "1800-2012": {
          "evidence": {
            "located_clause": "35.5.4",
            "printed_pages": [
              "908"
            ]
          },
          "revision_rule": {
            "clause": "35.5.4",
            "note": "The 2012 DPI prototype grammar lacks the dynamic_override_specifiers allowed by the 2023 grammar on method declarations in non-interface class scope.",
            "status": "changed-expectation"
          }
        },
        "1800-2017": {
          "evidence": {
            "located_clause": "35.5.4",
            "printed_pages": [
              "945"
            ]
          },
          "revision_rule": {
            "clause": "35.5.4",
            "note": "The 2017 import/export grammar has the same core productions but its function_prototype and task_prototype do not include the dynamic_override_specifiers added to the 2023 grammar.",
            "status": "changed-expectation"
          }
        }
      }
