{
  "$defs": {
    "StandardRevision": {
      "enum": [
        "1800-2012",
        "1800-2017",
        "1800-2023"
      ],
      "title": "StandardRevision",
      "type": "string"
    },
    "Waiver": {
      "additionalProperties": false,
      "properties": {
        "anchors": {
          "items": {
            "pattern": "^\\[2023:(?:(?:[1-9]|[1-3][0-9]|4[01])(?:\\.[1-9][0-9]*)*|[A-Q](?:\\.[1-9][0-9]*)*):[A-Z][A-Z0-9]*(?:[-.][A-Z0-9]+)*:p[0-9]{3,4}(?:-[0-9]{3,4})?\\]$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Anchors",
          "type": "array",
          "uniqueItems": true
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "part": {
          "pattern": "^(?:[1-9]|[1-3][0-9]|4[01]|[A-Q])$",
          "title": "Part",
          "type": "string"
        },
        "reason": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "id",
        "part",
        "anchors",
        "reason"
      ],
      "title": "Waiver",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "authority": {
      "$ref": "#/$defs/StandardRevision"
    },
    "part": {
      "pattern": "^(?:[1-9]|[1-3][0-9]|4[01]|[A-Q])$",
      "title": "Part",
      "type": "string"
    },
    "schema_version": {
      "maximum": 2,
      "minimum": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "waivers": {
      "items": {
        "$ref": "#/$defs/Waiver"
      },
      "minItems": 1,
      "title": "Waivers",
      "type": "array"
    }
  },
  "required": [
    "authority",
    "part",
    "schema_version",
    "waivers"
  ],
  "title": "WaiverPart",
  "type": "object"
}
