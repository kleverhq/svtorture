{
  "$defs": {
    "DashboardIndexCampaign": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[0-9]{8}T[0-9]{6}Z-[A-Za-z0-9](?:[A-Za-z0-9-]{0,126}[A-Za-z0-9])?$",
          "title": "Id",
          "type": "string"
        },
        "manifest": {
          "minLength": 1,
          "pattern": "^[^/\\\\\\x00][^\\\\\\x00]*$",
          "title": "Manifest",
          "type": "string"
        }
      },
      "required": [
        "id",
        "manifest"
      ],
      "title": "DashboardIndexCampaign",
      "type": "object"
    },
    "DashboardSchemas": {
      "additionalProperties": false,
      "properties": {
        "campaign": {
          "minLength": 1,
          "pattern": "^[^/\\\\\\x00][^\\\\\\x00]*$",
          "title": "Campaign",
          "type": "string"
        },
        "catalog": {
          "minLength": 1,
          "pattern": "^[^/\\\\\\x00][^\\\\\\x00]*$",
          "title": "Catalog",
          "type": "string"
        },
        "evidence": {
          "minLength": 1,
          "pattern": "^[^/\\\\\\x00][^\\\\\\x00]*$",
          "title": "Evidence",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "pattern": "^[^/\\\\\\x00][^\\\\\\x00]*$",
          "title": "Summary",
          "type": "string"
        },
        "trends": {
          "minLength": 1,
          "pattern": "^[^/\\\\\\x00][^\\\\\\x00]*$",
          "title": "Trends",
          "type": "string"
        },
        "verdicts": {
          "minLength": 1,
          "pattern": "^[^/\\\\\\x00][^\\\\\\x00]*$",
          "title": "Verdicts",
          "type": "string"
        }
      },
      "required": [
        "summary",
        "trends",
        "campaign",
        "catalog",
        "verdicts",
        "evidence"
      ],
      "title": "DashboardSchemas",
      "type": "object"
    }
  },
  "$id": "dashboard-index.schema.json",
  "additionalProperties": false,
  "properties": {
    "campaigns": {
      "items": {
        "$ref": "#/$defs/DashboardIndexCampaign"
      },
      "title": "Campaigns",
      "type": "array"
    },
    "default_campaign_id": {
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[A-Za-z0-9](?:[A-Za-z0-9-]{0,126}[A-Za-z0-9])?$",
      "title": "Default Campaign Id",
      "type": "string"
    },
    "kind": {
      "const": "dashboard-index",
      "default": "dashboard-index",
      "title": "Kind",
      "type": "string"
    },
    "schema_version": {
      "default": 6,
      "maximum": 6,
      "minimum": 6,
      "title": "Schema Version",
      "type": "integer"
    },
    "schemas": {
      "$ref": "#/$defs/DashboardSchemas"
    },
    "trends": {
      "minLength": 1,
      "pattern": "^[^/\\\\\\x00][^\\\\\\x00]*$",
      "title": "Trends",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "default_campaign_id",
    "campaigns",
    "trends",
    "schemas"
  ],
  "title": "DashboardIndex",
  "type": "object"
}
