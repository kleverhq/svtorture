{
  "$defs": {
    "CapturedStream": {
      "additionalProperties": false,
      "properties": {
        "excerpt": {
          "title": "Excerpt",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "excerpt",
        "size_bytes",
        "sha256",
        "truncated"
      ],
      "title": "CapturedStream",
      "type": "object"
    },
    "DashboardEvidenceResult": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/EvidenceLevel"
        },
        "evidence_mode": {
          "$ref": "#/$defs/EvidenceMode"
        },
        "known_issue": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Known Issue"
        },
        "observations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StageObservation"
          },
          "title": "Observations",
          "type": "array"
        },
        "profile_id": {
          "title": "Profile Id",
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/ReasonCode"
        },
        "requirement_id": {
          "title": "Requirement Id",
          "type": "string"
        },
        "schema_version": {
          "maximum": 2,
          "minimum": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/ResultStatus"
        },
        "summary": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "target_phase": {
          "$ref": "#/$defs/Phase"
        },
        "tool_id": {
          "title": "Tool Id",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "case_id",
        "requirement_id",
        "tool_id",
        "profile_id",
        "target_phase",
        "evidence_mode",
        "status",
        "reason",
        "summary",
        "evidence"
      ],
      "title": "DashboardEvidenceResult",
      "type": "object"
    },
    "Diagnostic": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code"
        },
        "column": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column"
        },
        "line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "message": {
          "maxLength": 4096,
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "pattern": "^(error|warning|fatal|note|info)$",
          "title": "Severity",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "target_case_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Case Id"
        }
      },
      "required": [
        "severity",
        "message"
      ],
      "title": "Diagnostic",
      "type": "object"
    },
    "EvidenceLevel": {
      "enum": [
        "mandatory",
        "exploratory"
      ],
      "title": "EvidenceLevel",
      "type": "string"
    },
    "EvidenceMode": {
      "enum": [
        "direct",
        "cumulative",
        "not-observed"
      ],
      "title": "EvidenceMode",
      "type": "string"
    },
    "Phase": {
      "enum": [
        "preprocess",
        "parse",
        "elaborate",
        "simulate"
      ],
      "title": "Phase",
      "type": "string"
    },
    "RawOutcome": {
      "enum": [
        "normal-exit",
        "signal",
        "timeout",
        "launch-failure",
        "container-failure",
        "backend-unavailable"
      ],
      "title": "RawOutcome",
      "type": "string"
    },
    "ReasonCode": {
      "enum": [
        "expectation-met",
        "unexpected-accept",
        "unexpected-reject",
        "missing-diagnostic",
        "off-target-diagnostic",
        "missing-pass-marker",
        "multiple-pass-markers",
        "pass-marker-with-nonzero-status",
        "wrong-runtime-result",
        "timeout",
        "crash",
        "internal-error",
        "container-failure",
        "launch-failure",
        "missing-artifact",
        "invalid-execution-plan",
        "unsupported-phase",
        "unsupported-revision",
        "not-applicable",
        "tool-unavailable",
        "manifest-mismatch",
        "output-truncated",
        "target-phase-unproven",
        "tool-preparation-failure"
      ],
      "title": "ReasonCode",
      "type": "string"
    },
    "ResultStatus": {
      "enum": [
        "conforming",
        "nonconforming",
        "inconclusive",
        "unsupported-capability",
        "unsupported-revision",
        "not-applicable",
        "skipped-unavailable",
        "harness-error"
      ],
      "title": "ResultStatus",
      "type": "string"
    },
    "StageKind": {
      "enum": [
        "compile",
        "run"
      ],
      "title": "StageKind",
      "type": "string"
    },
    "StageObservation": {
      "additionalProperties": false,
      "properties": {
        "artifact_present": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Present"
        },
        "attempted_through_phase": {
          "$ref": "#/$defs/Phase"
        },
        "diagnostics": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Diagnostic"
          },
          "title": "Diagnostics",
          "type": "array"
        },
        "duration_seconds": {
          "minimum": 0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "exit_code": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit Code"
        },
        "internal_error": {
          "default": false,
          "title": "Internal Error",
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/StageKind"
        },
        "outcome": {
          "$ref": "#/$defs/RawOutcome"
        },
        "portable_argv": {
          "items": {
            "type": "string"
          },
          "title": "Portable Argv",
          "type": "array"
        },
        "signal": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Signal"
        },
        "stage_id": {
          "title": "Stage Id",
          "type": "string"
        },
        "stderr": {
          "$ref": "#/$defs/CapturedStream"
        },
        "stdout": {
          "$ref": "#/$defs/CapturedStream"
        }
      },
      "required": [
        "stage_id",
        "kind",
        "attempted_through_phase",
        "outcome",
        "duration_seconds",
        "stdout",
        "stderr",
        "portable_argv"
      ],
      "title": "StageObservation",
      "type": "object"
    }
  },
  "$id": "campaign-evidence.schema.json",
  "additionalProperties": false,
  "properties": {
    "campaign_id": {
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[A-Za-z0-9](?:[A-Za-z0-9-]{0,126}[A-Za-z0-9])?$",
      "title": "Campaign Id",
      "type": "string"
    },
    "case_ids": {
      "items": {
        "type": "string"
      },
      "title": "Case Ids",
      "type": "array"
    },
    "kind": {
      "const": "campaign-evidence",
      "default": "campaign-evidence",
      "title": "Kind",
      "type": "string"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/DashboardEvidenceResult"
      },
      "title": "Results",
      "type": "array"
    },
    "schema_version": {
      "default": 6,
      "maximum": 6,
      "minimum": 6,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "campaign_id",
    "case_ids",
    "results"
  ],
  "title": "CampaignEvidenceShard",
  "type": "object"
}
