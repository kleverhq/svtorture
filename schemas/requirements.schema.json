          "anyOf": [
            {
              "pattern": "^(?:(?:[1-9]|[1-3][0-9]|4[01])(?:\\.[1-9][0-9]*)*|[A-Q](?:\\.[1-9][0-9]*)*)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clause"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
