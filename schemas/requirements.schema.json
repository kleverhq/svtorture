{
  "$defs": {
    "Applicability": {
      "enum": [
        "applicable",
        "same-rule-different-clause",
        "changed-expectation",
        "not-applicable",
        "not-assessed"
      ],
      "title": "Applicability",
      "type": "string"
    },
    "CoverageState": {
      "enum": [
        "covered",
        "partial",
        "deferred",
        "not-testable"
      ],
      "title": "CoverageState",
      "type": "string"
    },
    "Normativity": {
      "enum": [
        "normative",
        "informative"
      ],
      "title": "Normativity",
      "type": "string"
    },
    "Requirement": {
      "additionalProperties": false,
      "properties": {
        "chapter": {
          "maximum": 41,
          "minimum": 1,
          "title": "Chapter",
          "type": "integer"
        },
        "clause": {
          "pattern": "^[0-9]+(?:\\.[0-9]+)*$",
          "title": "Clause",
          "type": "string"
        },
        "coverage_state": {
          "$ref": "#/$defs/CoverageState"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "normativity": {
          "$ref": "#/$defs/Normativity"
        },
        "paragraph_anchor": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Paragraph Anchor",
          "type": "string"
        },
        "related_clauses": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Related Clauses",
          "type": "array"
        },
        "revision_applicability": {
          "additionalProperties": {
            "$ref": "#/$defs/RevisionRule"
          },
          "propertyNames": {
            "$ref": "#/$defs/StandardRevision"
          },
          "title": "Revision Applicability",
          "type": "object"
        },
        "standard_revision": {
          "$ref": "#/$defs/StandardRevision"
        },
        "summary": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "tags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "testability": {
          "$ref": "#/$defs/Testability"
        }
      },
      "required": [
        "id",
        "standard_revision",
        "chapter",
        "clause",
        "paragraph_anchor",
        "summary",
        "normativity",
        "testability",
        "coverage_state",
        "revision_applicability"
      ],
      "title": "Requirement",
      "type": "object"
    },
    "RevisionRule": {
      "additionalProperties": false,
      "properties": {
        "clause": {
          "anyOf": [
            {
              "pattern": "^[0-9]+(?:\\.[0-9]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clause"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "status": {
          "$ref": "#/$defs/Applicability"
        }
      },
      "required": [
        "status"
      ],
      "title": "RevisionRule",
      "type": "object"
    },
    "StandardRevision": {
      "enum": [
        "1800-2012",
        "1800-2017",
        "1800-2023"
      ],
      "title": "StandardRevision",
      "type": "string"
    },
    "Testability": {
      "enum": [
        "testable",
        "non-testable",
        "deferred"
      ],
      "title": "Testability",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "authority": {
      "$ref": "#/$defs/StandardRevision"
    },
    "requirements": {
      "items": {
        "$ref": "#/$defs/Requirement"
      },
      "title": "Requirements",
      "type": "array"
    },
    "schema_version": {
      "maximum": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "authority",
    "requirements"
  ],
  "title": "RequirementInventory",
  "type": "object"
}
