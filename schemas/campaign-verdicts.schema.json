{
  "$defs": {
    "CampaignCaseVerdicts": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "evidence_href": {
          "minLength": 1,
          "pattern": "^[^/\\\\\\x00][^\\\\\\x00]*$",
          "title": "Evidence Href",
          "type": "string"
        },
        "results": {
          "items": {
            "$ref": "#/$defs/CampaignVerdict"
          },
          "title": "Results",
          "type": "array"
        }
      },
      "required": [
        "case_id",
        "evidence_href",
        "results"
      ],
      "title": "CampaignCaseVerdicts",
      "type": "object"
    },
    "CampaignVerdict": {
      "additionalProperties": false,
      "properties": {
        "evidence_mode": {
          "$ref": "#/$defs/EvidenceMode"
        },
        "known_issue": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Known Issue"
        },
        "profile_id": {
          "title": "Profile Id",
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/ReasonCode"
        },
        "status": {
          "$ref": "#/$defs/ResultStatus"
        },
        "summary": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "tool_id": {
          "title": "Tool Id",
          "type": "string"
        }
      },
      "required": [
        "tool_id",
        "profile_id",
        "status",
        "reason",
        "evidence_mode",
        "summary"
      ],
      "title": "CampaignVerdict",
      "type": "object"
    },
    "EvidenceMode": {
      "enum": [
        "direct",
        "cumulative",
        "not-observed"
      ],
      "title": "EvidenceMode",
      "type": "string"
    },
    "ReasonCode": {
      "enum": [
        "expectation-met",
        "unexpected-accept",
        "unexpected-reject",
        "missing-diagnostic",
        "off-target-diagnostic",
        "missing-pass-marker",
        "multiple-pass-markers",
        "pass-marker-with-nonzero-status",
        "wrong-runtime-result",
        "timeout",
        "crash",
        "internal-error",
        "container-failure",
        "launch-failure",
        "missing-artifact",
        "invalid-execution-plan",
        "unsupported-phase",
        "unsupported-revision",
        "not-applicable",
        "tool-unavailable",
        "manifest-mismatch",
        "output-truncated",
        "target-phase-unproven",
        "tool-preparation-failure"
      ],
      "title": "ReasonCode",
      "type": "string"
    },
    "ResultStatus": {
      "enum": [
        "conforming",
        "nonconforming",
        "inconclusive",
        "unsupported-capability",
        "unsupported-revision",
        "not-applicable",
        "skipped-unavailable",
        "harness-error"
      ],
      "title": "ResultStatus",
      "type": "string"
    }
  },
  "$id": "campaign-verdicts.schema.json",
  "additionalProperties": false,
  "properties": {
    "campaign_id": {
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[A-Za-z0-9](?:[A-Za-z0-9-]{0,126}[A-Za-z0-9])?$",
      "title": "Campaign Id",
      "type": "string"
    },
    "case_count": {
      "minimum": 0,
      "title": "Case Count",
      "type": "integer"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/CampaignCaseVerdicts"
      },
      "title": "Cases",
      "type": "array"
    },
    "kind": {
      "const": "campaign-verdicts",
      "default": "campaign-verdicts",
      "title": "Kind",
      "type": "string"
    },
    "result_count": {
      "minimum": 0,
      "title": "Result Count",
      "type": "integer"
    },
    "schema_version": {
      "default": 6,
      "maximum": 6,
      "minimum": 6,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "campaign_id",
    "case_count",
    "result_count",
    "cases"
  ],
  "title": "CampaignVerdicts",
  "type": "object"
}
